<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
SPDX-FileCopyrightText: Hamza Mahjoubi
SPDX-License-Identifier: AGPL-3.0-or-later

Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES): only the keys build
settings cannot spell. WS-42.
-->
<dict>
	<key>NCMailAppGroup</key>
	<string>$(TeamIdentifierPrefix)com.nextcloud.mail.macos</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nextcloud.mail.macos.mailto</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mailto</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nextcloud.mail.macos.link</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ncmail</string>
			</array>
		</dict>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>New Nextcloud Mail message with selection</string>
			</dict>
			<key>NSMessage</key>
			<string>newMessageWithSelection</string>
			<key>NSPortName</key>
			<string>NextcloudMail</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
	</array>
	<!-- ADR-0108: in-app updates. The feed is the appcast committed at the repository's root;
	     every archive it lists must carry an EdDSA signature from this key. The installer
	     launcher service is what lets a sandboxed app hand the install to Sparkle. -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/hamza221/nc-mac-mail/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>niC0BqfTsIoSyzV8NKEGX00NWc22pj3YibovtCIeUrI=</string>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
