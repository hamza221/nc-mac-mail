<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Every extension is sandboxed; the widget reads one file and has no network (ADR-0071). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- ADR-0100: the container shared with the app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)com.nextcloud.mail.macos</string>
	</array>
</dict>
</plist>
